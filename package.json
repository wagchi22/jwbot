{
  "name": "jwbot",
  "version": "3.1.8",
  "description": "API de notificações do Jellyfin para WhatsApp",
  "license": "MIT",
  "main": "src/index.js",
  "bin": {
    "jwbot": "bin/jwbot.js"
  },
  "files": [
    ".env.example",
    "LICENSE",
    "README.md",
    "bin/",
    "src/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wagchi22/jwbot.git"
  },
  "bugs": {
    "url": "https://github.com/wagchi22/jwbot/issues"
  },
  "homepage": "https://github.com/wagchi22/jwbot#readme",
  "keywords": [
    "jellyfin",
    "whatsapp",
    "notifications",
    "bot"
  ],
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test",
    "release": "semantic-release",
    "prepare": "husky"
  },
  "release": {
    "branches": [
      "main"
    ],
    "tagFormat": "v${version}",
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "releaseRules": [
            {
              "type": "chore",
              "subject": "version releases without npm publishing (#10)",
              "release": false
            }
          ]
        }
      ],
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/npm",
        {
          "npmPublish": false
        }
      ],
      [
        "@semantic-release/git",
        {
          "assets": [
            "package.json",
            "package-lock.json"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
        }
      ],
      "@semantic-release/github"
    ]
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "https://github.com/Adi1231234/whatsapp-web.js/archive/85443fa4c8f86111457590dd06564c3efe0f6d1d.tar.gz"
  },
  "allowScripts": {
    "puppeteer@24.38.0": true
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/npm": "^11.0.3",
    "husky": "^9.1.7",
    "semantic-release": "^22.0.12"
  }
}
